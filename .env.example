
# ============================================================
# PhytoVision-X Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME=PhytoVision-X
DEMO_MODE=true
# Set to false when you have a trained model and real APIs

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./phytovision.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/phytovision

# --- ML Model ---
MODEL_PATH=models/plant_disease_model.pth
MODEL_TYPE=efficientnet_b0
# Options: efficientnet_b0, resnet50, custom

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.tiff

# --- AI Chatbot ---
# Google Gemini API (optional - enables AI chatbot)
GEMINI_API_KEY=your_gemini_api_key_here
# Leave empty for rule-based demo chatbot

# --- Satellite & Vegetation Health (Sentinel-2) ---
# Data Provider: 'copernicus' (default) or 'planetary_computer'
SENTINEL_DATA_PROVIDER=copernicus
# Copernicus Data Space - free registration at https://dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Planetary Computer API Key (optional - increases rate limits)
PLANETARY_COMPUTER_API_KEY=
# Search & Quality Filters
SENTINEL_MAX_CLOUD_COVER=20.0
SENTINEL_SEARCH_DAYS_BACK=30
# Vegetation Health / Stress Thresholds (Configurable)
# Healthy: NDVI >= NDVI_HEALTHY_THRESHOLD
# Moderate Stress: NDVI_MODERATE_THRESHOLD <= NDVI < NDVI_HEALTHY_THRESHOLD
# High Stress: NDVI < NDVI_MODERATE_THRESHOLD
NDVI_HEALTHY_THRESHOLD=0.60
NDVI_MODERATE_THRESHOLD=0.35

# --- Weather (free, no key needed) ---
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# --- CORS ---
FRONTEND_URL=http://localhost:5173
